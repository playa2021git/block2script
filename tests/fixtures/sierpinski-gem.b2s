scratch.script({x:40,y:40},()=>{
  scratch.event_whenflagclicked({});
  scratch.pen_penUp({});
  scratch.pen_clear({});
  scratch.pen_setPenSizeTo({SIZE:2});
  scratch.data_setvariableto({VARIABLE:"色",VALUE:0});
  scratch.pen_setPenColorParamTo({COLOR_PARAM:"color",VALUE:scratch.data_variable({VARIABLE:"色"})});
  scratch.data_deletealloflist({LIST:"xリスト"});
  scratch.data_deletealloflist({LIST:"yリスト"});
  scratch.data_deletealloflist({LIST:"長さリスト"});
  scratch.data_addtolist({ITEM:-140,LIST:"xリスト"});
  scratch.data_addtolist({ITEM:-120,LIST:"yリスト"});
  scratch.data_addtolist({ITEM:280,LIST:"長さリスト"});
  scratch.control_repeat_until({CONDITION:scratch.operator_equals({OPERAND1:scratch.data_lengthoflist({LIST:"長さリスト"}),OPERAND2:0}),SUBSTACK:()=>{
    scratch.data_setvariableto({VARIABLE:"x",VALUE:scratch.data_itemoflist({INDEX:scratch.data_lengthoflist({LIST:"xリスト"}),LIST:"xリスト"})});
    scratch.data_setvariableto({VARIABLE:"y",VALUE:scratch.data_itemoflist({INDEX:scratch.data_lengthoflist({LIST:"yリスト"}),LIST:"yリスト"})});
    scratch.data_setvariableto({VARIABLE:"辺の長さ",VALUE:scratch.data_itemoflist({INDEX:scratch.data_lengthoflist({LIST:"長さリスト"}),LIST:"長さリスト"})});
    scratch.data_deleteoflist({INDEX:scratch.data_lengthoflist({LIST:"xリスト"}),LIST:"xリスト"});
    scratch.data_deleteoflist({INDEX:scratch.data_lengthoflist({LIST:"yリスト"}),LIST:"yリスト"});
    scratch.data_deleteoflist({INDEX:scratch.data_lengthoflist({LIST:"長さリスト"}),LIST:"長さリスト"});
    scratch.control_if_else({CONDITION:scratch.operator_lt({OPERAND1:scratch.data_variable({VARIABLE:"辺の長さ"}),OPERAND2:20}),SUBSTACK:()=>{
      scratch.pen_setPenColorParamTo({COLOR_PARAM:"color",VALUE:scratch.data_variable({VARIABLE:"色"})});
      scratch.data_changevariableby({VARIABLE:"色",VALUE:2});
      scratch.motion_gotoxy({X:scratch.data_variable({VARIABLE:"x"}),Y:scratch.data_variable({VARIABLE:"y"})});
      scratch.motion_pointindirection({DIRECTION:90});
      scratch.pen_penDown({});
      scratch.control_repeat({TIMES:3,SUBSTACK:()=>{
        scratch.motion_movesteps({STEPS:scratch.data_variable({VARIABLE:"辺の長さ"})});
        scratch.motion_turnleft({DEGREES:120});
      }});
      scratch.pen_penUp({});
    },SUBSTACK2:()=>{
      scratch.data_setvariableto({VARIABLE:"辺の長さ",VALUE:scratch.operator_divide({NUM1:scratch.data_variable({VARIABLE:"辺の長さ"}),NUM2:2})});
      scratch.data_addtolist({ITEM:scratch.data_variable({VARIABLE:"x"}),LIST:"xリスト"});
      scratch.data_addtolist({ITEM:scratch.data_variable({VARIABLE:"y"}),LIST:"yリスト"});
      scratch.data_addtolist({ITEM:scratch.data_variable({VARIABLE:"辺の長さ"}),LIST:"長さリスト"});
      scratch.data_addtolist({ITEM:scratch.operator_add({NUM1:scratch.data_variable({VARIABLE:"x"}),NUM2:scratch.data_variable({VARIABLE:"辺の長さ"})}),LIST:"xリスト"});
      scratch.data_addtolist({ITEM:scratch.data_variable({VARIABLE:"y"}),LIST:"yリスト"});
      scratch.data_addtolist({ITEM:scratch.data_variable({VARIABLE:"辺の長さ"}),LIST:"長さリスト"});
      scratch.data_addtolist({ITEM:scratch.operator_add({NUM1:scratch.data_variable({VARIABLE:"x"}),NUM2:scratch.operator_divide({NUM1:scratch.data_variable({VARIABLE:"辺の長さ"}),NUM2:2})}),LIST:"xリスト"});
      scratch.data_addtolist({ITEM:scratch.operator_add({NUM1:scratch.data_variable({VARIABLE:"y"}),NUM2:scratch.operator_multiply({NUM1:scratch.data_variable({VARIABLE:"辺の長さ"}),NUM2:0.866})}),LIST:"yリスト"});
      scratch.data_addtolist({ITEM:scratch.data_variable({VARIABLE:"辺の長さ"}),LIST:"長さリスト"});
    }});
  }});
});
