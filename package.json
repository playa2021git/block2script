{
  "name": "block2script",
  "version": "1.0.0",
  "description": "Stretch3 editor with bidirectional Block2Script Script panel",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort --configLoader native",
    "build": "node native-scratch/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node tests/native-bridge.test.js && node tests/stretch-loader.test.js && node tests/safety.test.js && node tests/recovery.test.js && node tests/lesson-tools.test.js && node tests/extension-registry.test.js",
    "setup:native": "node native-scratch/setup.mjs",
    "build:stretch3": "node stretch3-base/build.mjs",
    "test:standard-extensions": "node stretch3-base/standard-extensions.test.mjs",
    "test:lesson-tools": "node stretch3-base/lesson-tools.test.mjs",
    "test:robot": "node stretch3-base/robot.test.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "setup:upstream": "node scripts/fetch-upstream.mjs",
    "setup:gui": "node scripts/install-gui.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "acorn": "^8.18.0",
    "blockly": "^13.3.0",
    "codemirror": "^6.0.2",
    "vite": "^8.3.2",
    "@codemirror/language": "6.12.4",
    "@lezer/highlight": "1.2.5"
  },
  "type": "module"
}
